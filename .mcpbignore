# Python caches
*.pyc
**/__pycache__/
.pytest_cache/

# Logs and local env
logs/
.env
.env.local

# Dev-only files (not needed inside the shipped bundle)
setup.py
build.sh
.venv/
.idea/
.vscode/
.claude/
tests/
pytests/
pytest.ini
requirements-test.txt

# Never ship the build artifact or VCS metadata inside itself
*.mcpb
.git/
.github/

# NOTE: src/lib IS bundled on purpose — it holds the vendored dependencies.

# Do not nest built bundles inside a bundle
dist/
